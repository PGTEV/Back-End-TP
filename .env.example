# SQLite permite arrancar sin instalar un servidor. Para PostgreSQL ver README.
DATABASE_URL=sqlite:///./data/expedientes.db
# DATABASE_URL=postgresql+psycopg://pmv:CAMBIAR@localhost:5432/pmv
# Producción (Supabase, Session pooler; se acepta postgresql:// y se fuerza psycopg + SSL):
# DATABASE_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
STORAGE_DIR=./data/originales
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Producción: CORS_ORIGINS=["https://expedientes-muni-front.vercel.app"]
MAX_FILE_MB=20
MAX_PAGES=30
MIN_DPI=150
MIN_OCR_CONFIDENCE=0.65
# Acceso local de un evaluador. No son credenciales de SISGEDOC ni firma digital.
# Generar una clave propia de al menos 32 caracteres; no subir .env a GitHub.
REVIEWER_TOKEN=
REVIEWER_ID=
PROTECT_DOSSIER_ROUTES=false
ACADEMIC_DEMO=false
OPENAI_ENABLED=false
AI_PROVIDER=openai
# Para Gemini: AI_PROVIDER=gemini, GEMINI_ENABLED=true y su clave solo en Render.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
# Modelo configurable: requiere acceso desde su proyecto OpenAI y salida estructurada en Responses.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=60
# Universidad: true habilita evidencias, firma/SISGEDOC/notificación SIMULADAS y modelo sintético.
# Render: true; configurar REVIEWER_TOKEN/REVIEWER_ID y CORS_ORIGINS con orígenes HTTPS exactos.

# OWASP: defaults locales compatibles. En staging/producción usar .env.production.example.
APP_ENVIRONMENT=development
REQUEST_METRICS_ENABLED=false
SECURITY_EVENTS_ENABLED=false
AUTH_RATE_LIMIT_ENABLED=false
AUTH_FAILURES_PER_WINDOW=30
SECURITY_WINDOW_SECONDS=60
SECURITY_MAX_ORIGINS=10000
OCR_LIMITS_ENABLED=false
OCR_REQUESTS_PER_WINDOW=20
OCR_MAX_CONCURRENT=2
PROTECT_DIAGNOSTICS=false
DIAGNOSTIC_CACHE_SECONDS=120
DISABLE_API_DOCS=false
SECURITY_HEADERS_ENABLED=false
HSTS_ENABLED=false
# Rotación: lista JSON de {"token":"...","expires_at":"...Z"}; nunca en frontend.
REVIEWER_TOKENS=[]
INDIVIDUAL_ACCOUNTS_ENABLED=false
# Cuentas individuales: ACADEMIC_ACCOUNTS con id, role, token, department y expires_at opcional.
STORAGE_ENCRYPTION_ENABLED=false
STORAGE_ENCRYPTION_KEYS=[]
