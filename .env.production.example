# Copiar variables al proveedor; NO versionar los valores reales.
# La aplicación rechaza este perfil si faltan protección o credenciales.
APP_ENVIRONMENT=production
PROTECT_DOSSIER_ROUTES=true
REVIEWER_ID=
REVIEWER_TOKEN=
REQUEST_METRICS_ENABLED=true
SECURITY_EVENTS_ENABLED=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_FAILURES_PER_WINDOW=30
SECURITY_WINDOW_SECONDS=60
OCR_LIMITS_ENABLED=true
OCR_REQUESTS_PER_WINDOW=20
OCR_MAX_CONCURRENT=2
PROTECT_DIAGNOSTICS=true
DIAGNOSTIC_CACHE_SECONDS=120
DISABLE_API_DOCS=true
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
CORS_ORIGINS=["https://expedientes-muni-front.vercel.app"]
ACADEMIC_DEMO=false
# Conservar DATABASE_URL y STORAGE_DIR actuales; verificar TLS/certificado y persistencia.
# Tras verificar el CA del proveedor, usar sslmode=verify-full y sslrootcert en DATABASE_URL.
# El cifrado opcional requiere instalar requirements-security-linux.lock.txt y guardar sus claves fuera de git.
STORAGE_ENCRYPTION_ENABLED=false
STORAGE_ENCRYPTION_KEYS=[]
# ACADEMIC_ACCOUNTS admite cuentas nominales fuera de demo SOLO con esta bandera:
INDIVIDUAL_ACCOUNTS_ENABLED=false
REVIEWER_TOKENS=[]
